#include <windows.h>

// Application Manifest: needed so that argv[] and filenames in file functions (fopen etc) are treated as UTF-8
1 24 "genozip_win.manifest" // CREATEPROCESS_MANIFEST_RESOURCE_ID=1 RT_MANIFEST=24

// The icon of the executable file itself. Note: The icon for .genozip files is set by the installer
IDI_ICON1 ICON "windows/genozip.ico" // The lowest integer ID (IDI_ICON1 / 101) becomes the default EXE icon in Windows Explorer

// The information shown when right-clicking on the executable->Properties->Details
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,0,0,0
PRODUCTVERSION  0,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName",    "Genozip. See: www.genozip.com"
            VALUE "LegalCopyright", "(C) Genozip Limited. Patent Pending."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
